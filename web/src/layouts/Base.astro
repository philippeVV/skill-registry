---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Skill Registry' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="OSS marketplace for Claude Code skills, rules, and knowledge" />
    <link rel="icon" type="image/svg+xml" href="/skill-registry/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="border-b border-gray-800">
      <nav class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href="/skill-registry/" class="text-lg font-semibold text-gray-100 hover:text-white">
          Skill Registry
        </a>
        <div class="flex gap-6 text-sm">
          <a href="/skill-registry/" class="text-gray-400 hover:text-gray-100 transition-colors">
            Home
          </a>
          <a href="/skill-registry/leaderboard/" class="text-gray-400 hover:text-gray-100 transition-colors">
            Leaderboard
          </a>
        </div>
      </nav>
    </header>

    <main class="flex-1 max-w-6xl mx-auto px-4 py-8 w-full">
      <slot />
    </main>

    <footer class="border-t border-gray-800">
      <div class="max-w-6xl mx-auto px-4 py-6 text-center text-sm text-gray-500">
        <a
          href="https://github.com/philippeVV/skill-registry"
          class="hover:text-gray-300 transition-colors"
        >
          GitHub
        </a>
      </div>
    </footer>
  </body>
</html>
