{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Package Metadata",
  "description": "Schema for skill registry package metadata.json files",
  "type": "object",
  "required": ["name", "type", "description", "tags", "author", "license"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$|^[a-z0-9]$",
      "description": "Kebab-case package name, must match directory name"
    },
    "type": {
      "type": "string",
      "enum": ["skill", "rule", "knowledge"],
      "description": "Package type determining artifact format and install target"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "One-line description for search and package cards"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "description": "Tags for discovery and filtering"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "description": "Author or team name"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "description": "License identifier (e.g., MIT, Apache-2.0)"
    },
    "notes": {
      "type": "string",
      "description": "Optional free text for caveats, performance characteristics, or model tier recommendations"
    },
    "install_target": {
      "type": "string",
      "enum": ["skills", "rules", "knowledge"],
      "description": "Override default install target for this package type"
    },
    "upstream": {
      "type": "object",
      "required": ["url", "path", "ref"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "description": "URL of the upstream repository"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Path within the upstream repository"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "Git ref to track (branch, tag, or commit)"
        }
      },
      "additionalProperties": false,
      "description": "Upstream source for external package tracking"
    }
  },
  "additionalProperties": false
}
